# config.yaml
# ────────────────────────────────────────────────────────────────────
# Central configuration for the Transcription System.
# Copy this file to config.yaml and adjust to your needs.
# Changes take effect after restarting the affected service(s):
#   sudo systemctl restart transcription-webgui
#   sudo systemctl restart transcription-worker
#   sudo systemctl restart transcription-watchfolder
#   sudo systemctl restart transcription-watchdog
# ────────────────────────────────────────────────────────────────────

version: "0.9.2-beta"


# ── Branding ─────────────────────────────────────────────────────────
branding:
  organization: "Your Organization"
  app_name: "Transcription"
  footer: "WhisperX · pyannote · Your Organization"
  system_subtitle: "System Status"
  queue_subtitle: "Queue"


# ── Color scheme ──────────────────────────────────────────────────────
# All values are CSS color strings (hex, rgb, named colors, etc.)
colors:
  bg: "#080808"
  surface: "#111111"
  surface2: "#1a1a1a"
  border: "#333333"
  border2: "#484848"
  text: "#f0f0f0"
  muted: "#888888"
  green: "#39d98a"    # done / active
  amber: "#ffcc00"    # running / warning
  red:   "#ff5555"    # error / danger
  blue:  "#58a6ff"    # info (reserved)


# ── Model settings ────────────────────────────────────────────────────
model:
  # Options: tiny, base, small, medium, large-v2, large-v3, large-v3-turbo
  # large-v3 requires ~6 GB VRAM; large-v3-turbo needs ~3 GB
  whisper_model: "large-v3"
  device: "cuda"
  default_language: null
  upload_languages:
    - ["en", "English"]
    - ["de", "Deutsch"]
    - ["es", "Español"]
  # Reduce batch_size if CUDA out-of-memory errors occur (try 2 or 1)
  batch_size: 2
  # Seconds between forced timecode breaks for single-speaker segments
  tc_interval: 60


# ── Watchdog ──────────────────────────────────────────────────────────
# Monitors all three services and restarts them if they fail.
# Also detects stuck worker jobs and requeues them.
watchdog:
  # Seconds between health checks
  poll_interval: 30
  # Seconds a job can be in 'running' state before it's considered stuck
  # Adjust based on your longest expected job duration
  stuck_job_timeout: 3600


# ── Priority queue ────────────────────────────────────────────────────
# Jobs are processed highest-priority first.
# Within the same priority, jobs are processed in submission order (FIFO).
# Running jobs are never interrupted — priority only affects queued jobs.
# Valid range: 1 (lowest) to 100 (highest).
priority:
  # Web GUI manual uploads — should always be highest
  manual_upload: 10
  # General watchfolder (single-mode entries without explicit priority)
  watchfolder_default: 5
  # Maximum number of manual retries allowed per job (via GUI ↺ button)
  max_retries: 3
  # Note: batch-mode watchfolder entries have their own priority
  # setting per entry in watchfolders.yaml


# ── Transcript output ─────────────────────────────────────────────────
transcript:
  date_label: "Date"
  file_label: "File"
  duration_label: "Duration"
  language_label: "Language"
  timecode_label: "Timecode start"
  separator_char: "─"
  separator_length: 44
  fallback_speaker: "SPEAKER_A"
