# .env.example
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
#
# Only secrets belong here. All other settings are in config.yaml.
# ─────────────────────────────────────────────────────────────────────

# Hugging Face token (required for speaker diarization)
# Get yours at: https://huggingface.co/settings/tokens
# Accept model terms at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_YourTokenHere

# Shared secret for the /webhook/ingest-complete endpoint
# Must match what your ingest system sends in X-Webhook-Secret header
WEBHOOK_SECRET=choose-a-strong-random-secret